# Published evidence, receipts, and source snapshots use exact byte hashes.
# Keep both original CRLF and LF bytes intact on Windows and Linux.
artifacts/** -text

# These implementation files are hash-bound by the frozen normalization cache.
src/world_models/data/replay.py -text
src/world_models/data/schema.py -text
src/world_models/models/heads.py -text
src/world_models/training/normalization.py -text

# Keep the sourced cluster environment helper executable by Linux Bash.
scripts/aspire2a_cuda.sh text eol=lf
scripts/gpu_server_env.sh text eol=lf
scripts/phase24_aspire2a.pbs text eol=lf
scripts/aspire2a_gpu_smoke.pbs text eol=lf

# P6.3 acceptance binds these manuscript, review and audit bytes on both hosts.
study_paper/** -text
paper/** -text
docs/phase63_paper.md -text
detailed_research_implementation_plan.md -text

# Model weights and full training checkpoints use Git LFS, including files
# above GitHub's 100 MiB regular-Git limit. Dataset exclusions in .gitignore
# take precedence over whether a binary has an LFS attribute.
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
