# Ignore local dependencies, datasets, generated runtime files and caches.
# Model weights/checkpoints stay included and use Git LFS through .gitattributes.

# Papers and generated research reports stay local.
/paper/
/papers/
/reports/
/research_reports/
/results/

# Local research plan and server setup guides.
/detailed_research_implementation_plan.md
/linux_gpu_server_setup.md
/linux_gpu_server_setup_through_p23.md

# Exclude artifact reports, results, figures and source/evidence snapshots.
# Traverse directories so model payloads and their required metadata can remain.
/artifacts/**
!/artifacts/**/
!/artifacts/.gitkeep
!/artifacts/README.md
!/artifacts/**/*.pt
!/artifacts/**/*.pth
!/artifacts/**/*.ckpt
!/artifacts/**/*.safetensors
!/artifacts/**/*.onnx
!/artifacts/**/*.bin
!/artifacts/**/checkpoints/**/manifest.json
!/artifacts/**/checkpoints/**/manifest.sha256
!/artifacts/**/checkpoints/update_*.sha256
!/artifacts/**/actor_*/manifest.json
!/artifacts/**/actor_*/manifest.sha256
!/artifacts/**/initial_student/manifest.json
!/artifacts/**/initial_student/manifest.sha256
!/artifacts/**/evaluation/real_*/manifest.json
!/artifacts/**/evaluation/real_*/manifest.sha256
!/artifacts/**/run_manifest.json
!/artifacts/**/run_manifest.sha256
!/artifacts/**/launch_plan.json
!/artifacts/**/launch_plan.sha256
!/artifacts/phase24_selection/**/selection.json
!/artifacts/phase24_selection/**/selection.sha256
!/artifacts/phase23/normalization/**/*.json
!/artifacts/phase23/normalization/**/*.sha256
!/artifacts/**/normalization_bindings.json
!/artifacts/**/normalization_bindings.sha256

# Local environments, installed tools and downloaded dependencies.
/.venv/
/.venv-*/
/.envs/
/venv/
/env/
/.tools/
.build_deps/
/wheelhouse/
/wheelhouse-*/

# Transfer bundles and downloaded archives (not model weights).
/transfer/
/transfers/
*.zip
*.zip.sha256
*.tar
*.tar.gz
*.tar.xz
*.tgz
*.7z
*.whl

# Python caches, build products and coverage.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
/build/
/dist/
.ipynb_checkpoints/
*.o

# Credentials and local editor settings.
.env
.env.*
!.env.example
!.env.template
/.aws/
/.codex/
/.agents/
/secrets/
/credentials.json
/token.json
*.pem
*.key
*.p12
*.pfx
/.vscode/
/.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Datasets: real replay and synthetic distillation trajectories.
# Apply after the model allowances: dataset shards can also have a .pt suffix.
# Root anchors preserve authored src/world_models/data modules.
/data/
/dataset/
/datasets/
/replay/
/replay_buffer/
/buffer/
/buffers/
/artifacts/**/real_replay/
/artifacts/**/replay/episodes/
/artifacts/**/buffer/
/artifacts/**/buffers/
/artifacts/**/replay_buffer/
/artifacts/**/synthetic_rollouts/
*.npz
*.npy
*.hdf5
*.h5
*.parquet
*.arrow
*.tfrecord
*.tfrecords

# Generated native runtime assets and raw visual recordings.
# Authored ACS/config/source remains included in its normal source directories.
/artifacts/**/runtime/
/artifacts/**/frames/
/artifacts/**/screenshots/
/artifacts/**/videos/
*.wad
*.pk3
*.lmp
*.mp4
*.avi
*.webm

# Disposable logs, profiling caches, transfer/job state and temporary files.
/logs/
/tensorboard/
/wandb/
/mlruns/
/tmp/
/temp/
/.cache/
/artifacts/**/.cache/
*.log
*.tmp
*.partial
*.pid
/p24_job.id
/p36_job.id
/artifacts/repository_audit/inventory.json

# Root weights/ and checkpoints/ remain included; model binaries use Git LFS.
