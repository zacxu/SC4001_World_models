+def _portable_report_relative_path(encoded: str) -> PurePosixPath:
+    """Decode old Windows report members in memory without rewriting evidence."""
+    if not isinstance(encoded, str) or not encoded.strip() or "\0" in encoded:
+        raise ValueError("report member path must be a nonempty relative string")
+    normalized = encoded.replace("\\", "/")
+    relative = PurePosixPath(normalized)
+    if (relative.is_absolute() or PureWindowsPath(encoded).drive
+            or PureWindowsPath(encoded).root or ".." in relative.parts):
+        raise ValueError("report member path escapes the dataset directory")
+    return relative
+
