#!/bin/bash -l
#PBS -N wm-gpu-smoke
#PBS -P 11704278
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=00:10:00
#PBS -j oe

# Basic allocation/runtime check only: no saved models or replay are loaded.
set -e
: "${PBS_JOBID:?Submit using qsub; do not run this script on the login node}"
export WM_ROOT=/home/users/create/smrksun/scratch/WM1
cd "$WM_ROOT"
mkdir -p artifacts/pbs
exec > "artifacts/pbs/gpu_smoke_${PBS_JOBID}.log" 2>&1
trap 'wm_code=$?; if (( wm_code != 0 )); then printf "FAIL: GPU smoke test exited with code %s\n" "$wm_code"; fi' EXIT

printf 'Job: %s\nHost: %s\nPBS GPU mask: %s\n' "$PBS_JOBID" "$(hostname)" "${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi
module load miniforge3
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$WM_ROOT/.envs/wm312"
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
source scripts/aspire2a_cuda.sh
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export CUBLAS_WORKSPACE_CONFIG=:4096:8 PYTHONUNBUFFERED=1

# Keep PBS's CUDA_VISIBLE_DEVICES and CUDA_DEVICE_ORDER unchanged.
python - <<'PY'
import os
import time
import torch

started = time.perf_counter()
print("PyTorch:", torch.__version__, "CUDA build:", torch.version.cuda)
print("CUDA_VISIBLE_DEVICES:", os.environ.get("CUDA_VISIBLE_DEVICES"))
assert torch.cuda.is_available(), "CUDA unavailable; inspect driver/compatibility setup"
print("Visible GPU count:", torch.cuda.device_count())
assert torch.cuda.device_count() == 1, "Expected one PBS-visible GPU; inspect the allocation mask"
device = torch.device("cuda:0")
torch.cuda.set_device(device)
print("Selected GPU:", torch.cuda.get_device_name(device))
assert torch.cuda.is_bf16_supported(), "bfloat16 support is required"

x = torch.ones((256, 256), device=device, dtype=torch.bfloat16)
assert torch.all(x @ x == 256).item(), "bfloat16 matrix multiplication failed"
print("PASS: bfloat16 matrix multiplication")

layer = torch.nn.Conv2d(3, 8, 3, padding=1).to(device)
image = torch.ones((2, 3, 32, 32), device=device)
with torch.autocast("cuda", dtype=torch.bfloat16):
    loss = layer(image).square().mean()
loss.backward()
assert torch.isfinite(loss).item()
assert layer.weight.grad is not None and torch.isfinite(layer.weight.grad).all().item()
torch.cuda.synchronize(device)
print("PASS: convolution forward/backward")

import world_models.models.world_model
import scripts.phase35
print("PASS: project model/training imports")
print(f"PASS: ASPIRE2A GPU smoke test ({time.perf_counter() - started:.2f}s inside Python)")
print("No research checkpoints, replay, training or evaluation were used.")
PY
